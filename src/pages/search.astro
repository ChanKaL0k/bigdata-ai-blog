---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
const kbArticles = (await getCollection("kb")).filter((p) => !p.data.draft);

const allItems = [
  ...blogPosts.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    url: `/blog/${p.slug}`,
    type: "博客",
    topic: p.data.topic,
    tags: p.data.tags,
    date: p.data.date,
  })),
  ...kbArticles.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    url: `/kb/${p.data.topic}/${p.slug}`,
    type: "知识库",
    topic: p.data.topic,
    tags: p.data.tags,
    date: p.data.date,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout>
  <div class="max-w-3xl mx-auto px-4 pt-12 pb-16">
    <h1 class="text-3xl font-bold mb-2">搜索</h1>
    <p class="mb-8" id="result-count" style="color: var(--color-text-secondary);">
      共 {allItems.length} 篇文章，按发布日期排序
    </p>

    <input
      type="text"
      id="search-input"
      placeholder="输入关键词搜索文章标题或标签..."
      class="w-full px-4 py-3 rounded-lg border mb-8 text-base focus:outline-none focus:ring-2"
      style="border-color: var(--color-border); background-color: var(--color-bg-secondary); color: var(--color-text);"
    />

    <div id="search-results">
      {allItems.map((item) => (
        <a
          href={item.url}
          class="search-item block p-4 rounded-lg border mb-3 hover:shadow-sm transition-all"
          style="border-color: var(--color-border); background-color: var(--color-bg-secondary);"
          data-title={item.title}
          data-tags={item.tags.join(",")}
        >
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs px-2 py-0.5 rounded-full" style="background-color: var(--color-accent); color: white;">{item.type}</span>
            <span class="text-xs" style="color: var(--color-text-secondary);">{item.topic}</span>
          </div>
          <div class="font-medium">{item.title}</div>
          <div class="text-sm" style="color: var(--color-text-secondary);">{item.description}</div>
        </a>
      ))}
    </div>

    <p id="no-results" class="hidden text-center py-8" style="color: var(--color-text-secondary);">
      没有找到匹配的文章，试试其他关键词
    </p>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById("search-input") as HTMLInputElement;
  const items = Array.from(document.querySelectorAll(".search-item")) as HTMLElement[];
  const noResults = document.getElementById("no-results") as HTMLElement;
  const countEl = document.getElementById("result-count");

  // Read query from URL param (client-side, since SSG can't access URL params)
  const urlParams = new URLSearchParams(window.location.search);
  const urlQuery = urlParams.get("q") || "";
  if (urlQuery) {
    input.value = urlQuery;
  }

  function matchText(q: string, el: HTMLElement): boolean {
    if (!q) return true;
    const title = (el.getAttribute("data-title") || "").toLowerCase();
    const tags = (el.getAttribute("data-tags") || "").toLowerCase();
    return title.includes(q) || tags.includes(q);
  }

  function doSearch() {
    const q = input.value.toLowerCase().trim();
    let visible = 0;

    items.forEach((el) => {
      const show = matchText(q, el);
      el.style.display = show ? "" : "none";
      if (show) visible++;
    });

    noResults.style.display = q && visible === 0 ? "block" : "none";
    if (countEl) {
      countEl.textContent = q
        ? `找到 ${visible} 篇匹配文章`
        : `共 ${items.length} 篇文章，按发布日期排序`;
    }
  }

  input.addEventListener("input", doSearch);
  doSearch();
</script>
