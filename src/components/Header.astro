---
import ThemeToggle from "./ThemeToggle";

const navLinks = [
  { href: "/blog", label: "博客" },
  { href: "/kb", label: "知识库" },
  { href: "/roadmap", label: "学习路线" },
];
---

<header class="sticky top-0 z-50 backdrop-blur border-b" style="background-color: var(--color-bg); border-color: var(--color-border);">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold hover:opacity-80 transition-opacity shrink-0" style="color: var(--color-accent);">
      BigData & AI
    </a>

    <div class="flex items-center gap-3">
      <form action="/search" method="GET" class="w-52">
        <div class="relative">
          <input
            type="text"
            name="q"
            id="header-search"
            placeholder="搜你感兴趣的"
            class="w-full px-3 py-1.5 pl-8 rounded-lg border text-sm focus:outline-none focus:ring-2"
            style="border-color: var(--color-border); background-color: var(--color-bg-secondary); color: var(--color-text);"
          />
          <svg class="absolute left-2 top-1.5 w-4 h-4" style="color: var(--color-text-secondary);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </form>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-gray-800"
          style="color: var(--color-text-secondary);"
        >
          {link.label}
        </a>
      ))}
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
